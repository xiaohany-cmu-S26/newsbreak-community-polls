# Copy this file to backend/.env and paste your real key (starts with sk-ant-api03-...).
ANTHROPIC_API_KEY=
# Provider: claude (needs ANTHROPIC_API_KEY + credit) | ollama (fully local, free) | mock (canned responses)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
# MOCK_LLM=1 forces the mock provider
MOCK_LLM=0
# Optional model overrides
TRIAGE_MODEL=claude-haiku-4-5-20251001
DRAFT_MODEL=claude-sonnet-5
# Demo: give every newly generated poll a simulated, realistic vote set immediately (never use outside the demo)
DEMO_SIM_VOTES=1
